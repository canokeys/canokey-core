+    @pytest.mark.parametrize("after_commit", [False, True])
+    def test_del_cred(self, device, PinToken, CredMgmt, after_commit):
+        req = FidoRequest(pin=PIN, rp={"id": "power-loss.test"}, options={"rk": True},
+                          key_params=[{"type": "public-key", "alg": ES256.ALGORITHM}])
+        registrations = []
+        for _ in range(2):
+            req.user = generate_user()
+            registrations.append(device.sendMC(*req.toMC()))
+        count = 2
+        for index, registration in enumerate(registrations):
+            descriptor = {"type": "public-key", "id": registration.auth_data.credential_data.credential_id}
+            CredMgmt.pin_uv_token = _get_pin_token_with_CM_permission(device)
+            device.send_err_injection(("%02x" % (80 + index)).encode(), p1=2 if after_commit else 0)
+            with pytest.raises(CtapError) as error:
+                CredMgmt.delete_cred(descriptor)
+            assert error.value.code == CtapError.ERR.OTHER
+            device.reboot()
+            count -= int(after_commit)
+            CredMgmt.pin_uv_token = _get_pin_token_with_CM_permission(device)
+            assert CredMgmt.get_metadata()[CredentialManagement.RESULT.EXISTING_CRED_COUNT] == count
+            assert len(CredMgmt.enumerate_rps()) == int(count != 0)
+            assertion_request = FidoRequest(req, options=None, allow_list=[descriptor])
+            if after_commit:
+                with pytest.raises(CtapError) as error:
+                    device.sendGA(*assertion_request.toGA())
+                assert error.value.code == CtapError.ERR.NO_CREDENTIALS
+            else:
+                assertion = device.sendGA(*assertion_request.toGA())
+                verify(registration, assertion, req.cdh)
+                CredMgmt.pin_uv_token = _get_pin_token_with_CM_permission(device)
